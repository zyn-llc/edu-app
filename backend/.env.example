# ---- core ----
ENVIRONMENT=dev
DATABASE_URL=postgresql+asyncpg://edu:edu@db:5432/edu
REDIS_URL=redis://redis:6379/0
DEFAULT_LANG=uz-Latn

# ---- auth ----
# PROD: generate a unique secret >=32 bytes, e.g. `openssl rand -hex 32`.
# The app refuses to boot in prod if this is the default or shorter than 32 bytes.
JWT_SECRET=change-me-in-prod
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# ---- OTP (phone verification) ----
OTP_TTL_SECONDS=300
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_COOLDOWN_SECONDS=60
OTP_REQUEST_DAILY_CAP=20
# DEV ONLY: returns the OTP in the API response (no SMS gateway yet).
# PROD: MUST be false; the app refuses to boot in prod if this is true.
OTP_DEBUG_RETURN=true

# ---- gamification ----
XP_PER_POINT=10
XP_PER_LEVEL=100

# ---- parent linking ----
LINK_CODE_TTL_SECONDS=600
CORS_ORIGINS=*  # DEV. PROD: https://bilim.uz,https://app.bilim.uz

# ---- SMS gateway ----
# dev: 'console' (logs the code, also returned in API response).
# prod: 'eskiz' (real SMS). The app refuses to boot in prod with 'console'.
SMS_PROVIDER=console
# TIRNOQ MAJBURIY: qiymatda bo'sh joy bor. Tirnoqsiz qoldirilsa, `.env` ni
# o'qiydigan shell skriptlari uni buyruq deb tushunadi
# ("tasdiqlash: command not found"). Brend nomidagi apostrof ham shu sabab
# olib tashlangan — Eskiz shabloni baribir apostrofsiz tasdiqlangan.
OTP_MESSAGE_TEMPLATE="Topagon tasdiqlash kodi: {code}"
# Eskiz creds (required when SMS_PROVIDER=eskiz). Get them from the Eskiz cabinet.
# Your OTP template must be approved by Eskiz moderation before real sends work.
ESKIZ_BASE_URL=https://notify.eskiz.uz/api
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

# ---- OTP per-IP caps (SMS-pumping protection) ----
# Per-phone caps alone don't stop an attacker who rotates numbers; each accepted
# request costs money at the SMS gateway. These bound damage per source IP.
OTP_IP_HOURLY_CAP=15
OTP_IP_DAILY_CAP=60
# Set true ONLY behind a trusted reverse proxy (nginx/Cloudflare) that overwrites
# X-Forwarded-For; otherwise clients could spoof the header to dodge IP caps.
TRUST_PROXY_HEADERS=false

# ---- pre-launch flags ----
# Dev ad stub: /ad-reward credits coins on the client's word (no real ad).
# Prod boot REFUSES while true. Flip to false for deploy; re-enable only after
# AdMob server-side verification is implemented.
ALLOW_CLIENT_AD_REWARDS=true
# Founder metrics at GET /v1/admin/stats with X-Admin-Key header.
# Empty = endpoint disabled. Generate: openssl rand -hex 24
ADMIN_API_KEY=
