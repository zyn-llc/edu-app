# =============================================================================
#  .env — PROD namunasi. VPS'da AYNAN `.env` deb nusxala va to'ldir:
#
#      cp .env.prod.example .env && chmod 600 .env && nano .env
#
#  NEGA `.env.prod` EMAS: `docker-compose.prod.yml` da `env_file: .env`
#  yozilgan va compose `${POSTGRES_USER}` kabi o'zgaruvchilarni ham shu
#  papkadagi `.env` dan o'qiydi. Faylni `.env.prod` deb qoldirsang compose
#  "POSTGRES_USER kerak" deb yiqiladi.
#
#  config.py da prod guardlari bor: ular qanoatlantirilmasa server prod'da
#  UMUMAN KO'TARILMAYDI (ataylab shunday). Har biri pastda ⚠ bilan belgilangan.
#  Deploy'dan oldin tekshir:
#      docker compose -f docker-compose.prod.yml exec api python scripts/preflight.py
# =============================================================================

# ---- Postgres konteyneri ----------------------------------------------------
# ⚠ MAJBURIY: compose bu uchtasisiz umuman ishga tushmaydi
# (`${POSTGRES_USER:?POSTGRES_USER kerak}`). Bular konteyner birinchi marta
# ko'tarilganda bazani YARATADI — keyin o'zgartirsang, eski volume'dagi
# foydalanuvchi o'zgarmaydi va api "password authentication failed" beradi.
POSTGRES_USER=topagon
POSTGRES_PASSWORD=BU_YERGA_KUCHLI_PAROL
POSTGRES_DB=topagon

# ---- core -------------------------------------------------------------------
ENVIRONMENT=prod

# Host = `db` (compose servis nomi) — konteyner ichidagi manzil, to'g'ri.
# ⚠ GUARD 3: user/parol/db YUQORIDAGI POSTGRES_* bilan AYNAN mos bo'lsin va
#   `edu:edu@` bo'lmasin.
DATABASE_URL=postgresql+asyncpg://topagon:BU_YERGA_KUCHLI_PAROL@db:5432/topagon
REDIS_URL=redis://redis:6379/0
DEFAULT_LANG=uz-Latn

# ---- auth -------------------------------------------------------------------
# ⚠ GUARD 1: >=32 belgi va default emas.
#   openssl rand -hex 32
JWT_SECRET=BU_YERGA_64_BELGILI_HEX
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# ---- OTP --------------------------------------------------------------------
OTP_TTL_SECONDS=300
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_COOLDOWN_SECONDS=60
OTP_REQUEST_DAILY_CAP=20
# ⚠ GUARD 2: prod'da MAJBURIY false — aks holda OTP kodi API javobida qaytadi.
OTP_DEBUG_RETURN=false

# ---- gamification -----------------------------------------------------------
XP_PER_POINT=10
XP_PER_LEVEL=100

# ---- parent linking / CORS --------------------------------------------------
LINK_CODE_TTL_SECONDS=600
# ⚠ GUARD 4: `*` bo'lmasin. Flutter mobil klient CORS'ga qaramaydi; bu Flutter
#   Web uchun. Sxema va port bilan AYNAN mos bo'lsin (`https://topagon.uz` va
#   `https://www.topagon.uz` — ikkalasi kerak bo'lsa vergul bilan).
# Ilova endi app.topagon.uz da (topagon.uz — reklama sahifasi, u API'ga
# umuman murojaat qilmaydi). Vergul bilan bir nechta manzil berish mumkin.
# DIQQAT: prod guard `*` ni qabul qilmaydi — server ko'tarilmaydi.
CORS_ORIGINS=https://app.topagon.uz

# Murojaatlar (ilovadagi "Yordam" formasi va botga yozilgan xabarlar) shu
# chatga yuboriladi. Bo'sh yoki 0 bo'lsa faqat bazaga yoziladi va hech kim
# ko'rmaydi — shuning uchun uni to'ldiring.
#
# ID ni olish: botga bitta xabar yozing, keyin
#   curl "https://api.telegram.org/bot<TOKEN>/getUpdates"
# javobidagi message.chat.id. Guruhda ID manfiy bo'ladi (-100...).
TELEGRAM_ADMIN_CHAT_ID=0

# ---- SMS --------------------------------------------------------------------
# ⚠ GUARD 5: `console` bo'lmasin.
#   eskiz    — real SMS (yuridik shaxs + tasdiqlangan shablon kerak)
#   disabled — telefon+OTP butunlay yopiq
#
# HOZIRGI TANLOV: `disabled`. Yuridik shaxs yo'q, Eskiz shabloni tasdiqlanmagan.
# ⚠ GUARD 5b: `disabled` bo'lganda INVITE yoki TELEGRAM yoqilgan bo'lishi SHART,
#   aks holda ilovaga kirishning HECH QANDAY yo'li qolmaydi.
SMS_PROVIDER=disabled
# DIQQAT — ikkita qoida:
#   1. Qiymatda bo'sh joy bor, shuning uchun TIRNOQ ichida. Aks holda
#      `set -a; source .env` buni buyruq deb o'qiydi ("tasdiqlash: command
#      not found"). Docker Compose env_file tirnoqni o'zi olib tashlaydi.
#   2. Apostrof YO'Q ("Topag'on" emas) — yopilmagan apostrof butun faylni
#      buzadi.
OTP_MESSAGE_TEMPLATE="Topagon tasdiqlash kodi: {code}"
ESKIZ_BASE_URL=https://notify.eskiz.uz/api
# ⚠ GUARD 6: SMS_PROVIDER=eskiz bo'lsa ikkalasi ham to'ldirilgan bo'lishi shart.
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

# ---- per-IP caps ------------------------------------------------------------
OTP_IP_HOURLY_CAP=15
OTP_IP_DAILY_CAP=60
# nginx X-Forwarded-For ni O'ZI yozadi (proxy_params_bilim), shuning uchun
# nginx orqasida true xavfsiz. nginx'siz to'g'ridan ochsang — false qil.
TRUST_PROXY_HEADERS=true

# ---- Alternativ kirish ------------------------------------------------------
# Taklif kodi: telefonsiz akkaunt, yopiq beta uchun. 30 ta sinovchi shu yo'l
# bilan kiradi:
#   python scripts/make_invites.py --count 1 --uses 40 --label "Beta"
INVITE_LOGIN_ENABLED=true
INVITE_IP_HOURLY_CAP=10

# Telegram: @BotFather dan bot ochib, tokenni shu yerga qo'y.
#
# ⚠ BU FAYL NAMUNA — REPOGA TUSHADI. HECH QACHON HAQIQIY TOKEN YOZMA.
#   (2026-08-05 da shu yerda haqiqiy token turgan edi va olib tashlandi;
#   o'sha token @BotFather → /revoke bilan BEKOR QILINISHI shart.)
#
# USERNAME `@` SIZ va aynan botning nomi bo'lsin (shaxsiy akkaunt emas):
#   to'g'ri:   topagonuzbot
#   noto'g'ri: @topagonuzbot , @zayniddin_1904
# Deep link shundan yasaladi: https://t.me/<USERNAME>?start=<nonce>
#
# ⚠ TELEGRAM_LOGIN_ENABLED=true bo'lsa TOKEN va WEBHOOK_SECRET majburiy.
#   Webhook'ni o'rnatish: python scripts/telegram_setup.py --webhook
#   (avval VPS'dan `nslookup api.telegram.org` ishlashiga ishonch hosil qil)
TELEGRAM_LOGIN_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=topagonuzbot
# openssl rand -hex 24 — webhook'ni faqat Telegram chaqira olsin.
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_LOGIN_TTL_SECONDS=600

# ---- pre-launch flags -------------------------------------------------------
# ⚠ GUARD 7: false. AdMob umuman integratsiya qilinmagan; true bo'lsa har bir
#   foydalanuvchi bitta HTTP so'rov bilan kunlik tanga limitini o'ziga yozadi.
ALLOW_CLIENT_AD_REWARDS=false

# Bo'sh qoldirsang /v1/admin/* butunlay 404 qaytaradi. Retention statistikasi
# (`/v1/admin/analytics`) shu kalit bilan ochiladi — beta uchun kerak.
#
# ⚠ Bu kalit BUTUN admin yuzasini ochadi: barcha murojaatlar (aloqa
#   ma'lumotlari bilan), retention va referral grafigi. Uni qisqa qilma —
#   `openssl rand -hex 24`. Ikkinchi qatlam sifatida `deploy/nginx.conf` dagi
#   `location /v1/admin/` blokida IP cheklovini ham yoq.
ADMIN_API_KEY=

# ---- admin yuzasi -----------------------------------------------------------
# `/v1/admin/*` ni SHU IP dan tashqari hamma uchun yopadi (nginx darajasida,
# X-Admin-Key dan oldingi qatlam). `bash deploy.sh nginx` shu qiymatni
# `deploy/nginx.conf` dagi `__ADMIN_IP__` o'rniga qo'yadi.
#
# ATAYLAB `.env` DA, kodda emas: bu sizning uy/ofis manzilingiz va u git'ga
# tushmasligi kerak. O'zgaruvchan IP bo'lsa — VPN/WireGuard manzilini yozing,
# yoki bo'sh qoldiring (o'shanda faqat kalit + 20/soat cheklov qoladi).
#
#   IP ni bilish:  curl -s ifconfig.me
ADMIN_IP=

# ---- zaxira nusxa -----------------------------------------------------------
# `scripts/backup.sh` dump'ni SHU SERVERDA `backups/` ga yozadi. VPS yo'qolsa
# u ham yo'qoladi — ya'ni bu zaxira emas, nusxa. Tashqi manzil berilsa,
# skript har dump'dan keyin uni `rclone` bilan ko'chiradi va yuklash
# muvaffaqiyatsiz bo'lsa xato kodi bilan tugaydi.
#
#   rclone config          # bir marta: R2 / S3 / Google Drive
#   BACKUP_REMOTE=r2:topagon-backups
#
# Bo'sh qoldirilsa skript ishlaydi, lekin cron log'ida har kuni
# ogohlantirish chiqaradi.
BACKUP_REMOTE=
