# =============================================================================
#  Production .env template. On the server, copy it to exactly `.env`:
#
#      cp .env.prod.example .env && chmod 600 .env && nano .env
#
#  It must be named `.env`, not `.env.prod`: docker-compose.prod.yml declares
#  `env_file: .env` and also reads variables such as ${POSTGRES_USER} from the
#  `.env` in this folder. Leave it named `.env.prod` and compose exits saying
#  POSTGRES_USER is required.
#
#  config.py enforces production guards; if one fails the server refuses to
#  start, on purpose. Each is marked with (!) below. Check before deploying:
#      docker compose -f docker-compose.prod.yml exec api python scripts/preflight.py
# =============================================================================

# ---- Postgres container -----------------------------------------------------
# (!) Required: compose will not start without these three. They create the
# database the first time the container comes up, so changing them later does
# not change the user in the existing volume and the API then fails with
# "password authentication failed".
POSTGRES_USER=topagon
POSTGRES_PASSWORD=STRONG_PASSWORD_HERE
POSTGRES_DB=topagon

# ---- core -------------------------------------------------------------------
ENVIRONMENT=prod

# Host `db` is the compose service name, i.e. the address inside the network.
# (!) Guard 3: user, password and database must match the POSTGRES_* values
#     above, and must not be the `edu:edu@` default.
DATABASE_URL=postgresql+asyncpg://topagon:STRONG_PASSWORD_HERE@db:5432/topagon
REDIS_URL=redis://redis:6379/0
DEFAULT_LANG=uz-Latn

# ---- auth -------------------------------------------------------------------
# (!) Guard 1: at least 32 characters and not the default.
#     openssl rand -hex 32
JWT_SECRET=64_HEX_CHARACTERS_HERE
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# ---- OTP --------------------------------------------------------------------
OTP_TTL_SECONDS=300
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_COOLDOWN_SECONDS=60
OTP_REQUEST_DAILY_CAP=20
# (!) Guard 2: must be false in production, otherwise the OTP code is returned
#     in the API response.
OTP_DEBUG_RETURN=false

# ---- gamification -----------------------------------------------------------
XP_PER_POINT=10
XP_PER_LEVEL=100

# ---- parent linking / CORS --------------------------------------------------
LINK_CODE_TTL_SECONDS=600
# (!) Guard 4: never `*`. This only matters for Flutter Web; the mobile client
#     ignores CORS. Scheme and port must match exactly, and multiple origins are
#     comma separated. The app lives on app.topagon.uz; topagon.uz is the
#     marketing page and never calls the API.
CORS_ORIGINS=https://app.topagon.uz

# Support messages (the in-app help form and messages sent to the bot) go to
# this chat. Left at 0 they are only written to the database and nobody sees
# them, so fill it in.
#
# To find the id, send the bot a message and read message.chat.id from:
#   curl "https://api.telegram.org/bot<TOKEN>/getUpdates"
# Group ids are negative (-100...).
TELEGRAM_ADMIN_CHAT_ID=0

# ---- SMS --------------------------------------------------------------------
# (!) Guard 5: must not be `console`.
#     eskiz    - real SMS (needs a company account and an approved template)
#     disabled - phone + OTP login is turned off entirely
#
# (!) Guard 5b: with `disabled`, invite or Telegram login must be enabled,
#     otherwise there is no way into the app at all.
SMS_PROVIDER=disabled
# Two rules for this value: keep the quotes, because it contains spaces and
# `set -a; source .env` would otherwise read it as a command; and keep it free
# of apostrophes, since an unclosed one breaks the whole file.
OTP_MESSAGE_TEMPLATE="Topagon tasdiqlash kodi: {code}"
ESKIZ_BASE_URL=https://notify.eskiz.uz/api
# (!) Guard 6: both are required when SMS_PROVIDER=eskiz.
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

# ---- per-IP caps ------------------------------------------------------------
OTP_IP_HOURLY_CAP=15
OTP_IP_DAILY_CAP=60
# nginx sets X-Forwarded-For itself (proxy_params_bilim), so trusting it is
# safe behind nginx. Exposed directly, set this to false.
TRUST_PROXY_HEADERS=true

# ---- alternative login ------------------------------------------------------
# Invite codes allow an account without a phone number, used for closed beta:
#   python scripts/make_invites.py --count 1 --uses 40 --label "Beta"
INVITE_LOGIN_ENABLED=true
INVITE_IP_HOURLY_CAP=10

# Telegram: create a bot with @BotFather and put the token here.
#
# This file is a template and is committed. Never put a real token in it.
#
# The username goes in without `@` and must be the bot, not a personal account:
#   correct:   topagonuzbot
#   wrong:     @topagonuzbot
# The deep link is built from it: https://t.me/<USERNAME>?start=<nonce>
#
# (!) With TELEGRAM_LOGIN_ENABLED=true the token and webhook secret are
#     required. Register the webhook with:
#       python scripts/telegram_setup.py --webhook
TELEGRAM_LOGIN_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=topagonuzbot
# openssl rand -hex 24 - so only Telegram can call the webhook.
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_LOGIN_TTL_SECONDS=600

# ---- pre-launch flags -------------------------------------------------------
# (!) Guard 7: keep false. Ad rewards are not integrated; with true, any user
#     can grant themselves the daily coin cap with a single HTTP request.
ALLOW_CLIENT_AD_REWARDS=false

# Leave empty and /v1/admin/* returns 404 for everyone. Retention statistics
# (/v1/admin/analytics) are behind this key.
#
# The key opens the whole admin surface, including support messages with
# contact details. Make it long - `openssl rand -hex 24` - and add the IP
# restriction in the `location /v1/admin/` block of deploy/nginx.conf as a
# second layer.
ADMIN_API_KEY=
# Closes /v1/admin/* to everyone except this address at the nginx level, before
# the key is even checked. `bash deploy.sh nginx` substitutes it for
# __ADMIN_IP__ in deploy/nginx.conf.
#
# It lives here rather than in code because it is a home or office address and
# should not end up in git. On a dynamic address use a VPN address, or leave it
# empty and rely on the key plus the 20/hour limit.
#
#   curl -s ifconfig.me
ADMIN_IP=

# ---- backups ----------------------------------------------------------------
# scripts/backup.sh writes the dump to `backups/` on this same server, so it is
# a copy rather than a backup: lose the VPS and it goes too. Set a remote and
# the script uploads each dump with rclone, failing loudly if the upload fails.
#
#   rclone config          # once: R2 / S3 / Google Drive
#   BACKUP_REMOTE=r2:topagon-backups
#
# Left empty the script still runs, but warns in the cron log every day.
BACKUP_REMOTE=
